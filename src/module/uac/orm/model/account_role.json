{
    "name": "account_role",
    "title": "账号角色表",
    "desc": "记录账号的角色数据",
    "prepare": {
        "idx": {
            "unique": [],
            "multiple": [],
            "normal": ["uuid", "roleid"]
        }
    },
    "columns": {
        "uuid":     ["UUID","账号全局唯一编号",12],
        "roleid":   ["角色编码","角色的全局唯一编码",6],
        "entryat":  ["录入时间","此账号拥有此角色的时间",4]
    },
    "creation": {
        "uuid":     "uuid NOT NULL",
        "roleid":   "varchar(32) NOT NULL",
        "entryat":  "datetime NOT NULL DEFAULT now"
    },
    "join": {},
    "column": {
        "includes": ["uuid", "roleid"],
        "sort": ["uuid", "roleid", "entryat"],
        "search": ["uuid", "roleid"],
        "select": {
            "uuid": {
                "dynamic": true,
                "multiple": false,
                "source": {
                    "table": "account",
                    "value": "uuid",
                    "label": "name"
                }
            },
            "roleid": {
                "dynamic": true,
                "multiple": false,
                "source": {
                    "table": "role",
                    "value": "roleid",
                    "label": "name"
                }
            }
        },
        "datetime": {
            "entryat": {
                "type": "datetime"
            }
        }
    }
}