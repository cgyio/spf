{
    "driver": "mysql",
    "connect": {
        "host": "127.0.0.1",
        "port": 3306,
        "database": "%{DBN}%",
        "username": "",
        "password": ""
    },
    "name": "%{DBN}%",
    "title": "统一账号库",
    "desc": "可被多项目多应用同时使用的统一账号数据库，必须在各使用的 App 应用内创建一份此配置文件的副本（使用 mixin 方式；driver，connect，name，title，desc项目不会被继承，由各应用自行定义）。如果有自定义的数据模型类，应在对应的 模型名下定义实际的 class 类名路径。自定义的模型类必须扩展自默认的模型类",

    
    "required": ["account","role", "account_iso", "account_role", "account_auth", "role_auth"],

    "model": {
        "_default_": {
            "name": "%{MDK}%",
            "class": "module/uac/orm/model/%{MDN}%"
        },

        "account": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/account.json"
            }
        },

        "role": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/role.json"
            }
        },

        "organize": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/organize.json"
            }
        },

        "account_iso": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/account_iso.json"
            }
        },

        "account_role": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/account_role.json"
            }
        },

        "account_auth": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/account_auth.json"
            }
        },

        "role_auth": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/role_auth.json"
            }
        },

        "account_organize": {
            "prepare": {
                "extends": "spf/module/uac/orm/model/account_organize.json"
            }
        }
    }
}